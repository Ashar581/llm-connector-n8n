{
	"name": "n8n-nodes-scraper-agent",
	"version": "2.44.0",
	"description": "Scraper Agent node for n8n - wraps a web scraping service",
	"main": "index.js",
	"typesVersions": {
		"*": {
			"nodes/ScraperAgent/ScraperAgent.node": ["dist/nodes/ScraperAgent/ScraperAgent.node.d.ts"]
		}
	},
	"scripts": {
		"clean": "rimraf dist .turbo",
		"build": "tsc --build tsconfig.build.json && node scripts/copy-static-files.mjs && tsc-alias -p tsconfig.build.json",
		"build:unchecked": "tsc --build tsconfig.build.json --noCheck && node scripts/copy-static-files.mjs && tsc-alias -p tsconfig.build.json",
		"format": "biome format --write .",
		"format:check": "biome ci .",
		"lint": "eslint nodes --quiet",
		"lint:fix": "eslint nodes --fix",
		"watch": "tsc-watch -p tsconfig.build.json --onSuccess \"tsc-alias -p tsconfig.build.json\"",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:dev": "vitest --silent=false"
	},
	"files": ["dist"],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"nodes": ["dist/nodes/ScraperAgent/ScraperAgent.node.js"]
	},
	"devDependencies": {
		"@n8n/eslint-config": "workspace:*",
		"@n8n/typescript-config": "workspace:*",
		"@n8n/vitest-config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:typescript",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-mock-extended": "catalog:"
	},
	"dependencies": {
		"n8n-workflow": "workspace:*"
	},
	"license": "LicenseRef-n8n-sustainable-use"
}